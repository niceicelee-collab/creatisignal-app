    {
      "para_index": 1,
      "text": "PRODUCT OPTIMIZATION REQUIREMENTS",
      "style": "Normal"
    },
    {
      "para_index": 4,
      "text": "\u7248\u672c\uff1aV1.0",
      "style": "Normal"
    },
    {
      "para_index": 5,
      "text": "\u65e5\u671f\uff1a2026-08-31",
      "style": "Normal"
    },
    {
      "para_index": 6,
      "text": "\u9ed8\u8ba4\u6a21\u578b\uff1aQwen 3.7 Plus\uff08\u6a21\u578b\u6807\u8bc6\u7531\u540e\u7aef\u914d\u7f6e\uff0c\u4e0d\u5728\u524d\u7aef\u5199\u6b7b\uff09",
      "style": "Normal"
    },
    {
      "para_index": 7,
      "text": "\u76ee\u6807\u7528\u6237\uff1a\u4f7f\u7528\u4e2d\u6587\u5de5\u4f5c\u7684\u51fa\u6d77\u8fd0\u8425\u3001\u7f16\u5bfc\u3001\u7d20\u6750\u56e2\u961f\u4e0e\u89c6\u9891\u751f\u6210\u64cd\u4f5c\u8005",
      "style": "Normal"
    },
    {
      "para_index": 8,
      "text": "\u8bc1\u636e\u8303\u56f4\uff1a\u56fe1\u20133 \u5f53\u524d\u4ea7\u54c1\uff1b\u56fe4\u20136 \u53c2\u8003\u4ea7\u54c1\uff1b\u56fe7 \u5ba2\u6237\u539f\u58f0\u53cd\u9988\uff1b\u5f53\u524d\u4ed3\u5e93\u5b9e\u73b0\u57fa\u7ebf",
      "style": "Normal"
    },
    {
      "para_index": 9,
      "text": "\u6587\u6863\u72b6\u6001\uff1a\u53ef\u8fdb\u5165\u4ea7\u54c1/\u8bbe\u8ba1/\u524d\u540e\u7aef/\u6a21\u578b\u5de5\u7a0b\u6280\u672f\u8bc4\u5ba1",
      "style": "Normal"
    },
    {
      "para_index": 56,
      "text": "\u9009\u62e9\u5546\u54c1\uff1a\u4ece\u516c\u5171\u5546\u54c1\u5e93\u9009\u62e9\uff1b\u5c55\u793a\u6700\u8fd1\u4f7f\u7528\u3001\u7f29\u7565\u56fe\u3001\u540d\u79f0\u548c\u4e3b\u8981\u8d44\u4ea7\u3002",
      "style": "Normal"
    },
    {
      "para_index": 57,
      "text": "\u8bbe\u7f6e\u521b\u4f5c\u6761\u4ef6\uff1a\u8f93\u5165\u53ef\u9009\u521b\u610f\u63cf\u8ff0\uff0c\u9009\u62e9\u81ea\u52a8/\u660e\u786e\u98ce\u683c\u3001\u76ee\u6807\u8bed\u8a00\u30015\u201360 \u79d2\u65f6\u957f\u548c 1\u20135 \u4e2a\u811a\u672c\u6570\u91cf\u3002",
      "style": "Normal"
    },
    {
      "para_index": 58,
      "text": "\u751f\u6210\u591a\u4e2a\u65b9\u5411\uff1a\u7cfb\u7edf\u51bb\u7ed3\u5546\u54c1\u4e8b\u5b9e\u5e76\u751f\u6210\u5dee\u5f02\u5316\u65b9\u5411\uff1b\u89e3\u6790\u5931\u8d25\u6700\u591a\u81ea\u52a8\u4fee\u590d 1 \u6b21\u3002",
      "style": "Normal"
    },
    {
      "para_index": 59,
      "text": "\u5feb\u901f\u6bd4\u8f83\uff1a\u7528\u6237\u6536\u85cf\u3001\u7f6e\u9876\u3001\u52fe\u9009\u6700\u591a3\u4e2a\u811a\u672c\uff0c\u67e5\u770b\u5dee\u5f02\u7ef4\u5ea6\u548c\u5173\u952e\u5206\u955c\u3002",
      "style": "Normal"
    },
    {
      "para_index": 60,
      "text": "\u9009\u62e9\u5e76\u7f16\u8f91\uff1a\u8fdb\u5165\u5206\u955c\u5361\u7247\u7f16\u8f91\u5668\uff0c\u624b\u52a8\u4fee\u6539\u6216\u5bf9\u5355\u5b57\u6bb5/\u5355\u955c AI \u91cd\u5199\u3002",
      "style": "Normal"
    },
    {
      "para_index": 61,
      "text": "\u4fdd\u5b58\u7248\u672c\uff1a\u7f16\u8f91\u81ea\u52a8\u4fdd\u5b58\u4e3a\u8349\u7a3f\uff1bAI \u91cd\u5199\u4ea7\u751f revision\uff0c\u53ef\u64a4\u9500\u6216\u6062\u590d\u3002",
      "style": "Normal"
    },
    {
      "para_index": 62,
      "text": "\u6821\u9a8c\u5e76\u751f\u6210\u89c6\u9891\uff1a\u68c0\u67e5\u65f6\u957f\u3001\u4e8b\u5b9e\u3001\u76ee\u6807\u8bed\u8a00\u548c\u8d44\u4ea7\uff1b\u901a\u8fc7\u540e\u628a\u7ed3\u6784\u5316\u811a\u672c\u63d0\u4ea4\u89c6\u9891\u751f\u6210\u3002",
      "style": "Normal"
    },
    {
      "para_index": 81,
      "text": "\u9a8c\u6536\uff1a\u4ece\u5546\u54c1\u5e93\u65b0\u589e/\u7f16\u8f91\u5546\u54c1\u540e\u53ef\u5728\u811a\u672c\u9009\u62e9\u5668\u770b\u5230\uff1b\u811a\u672c\u4e2d\u7684 asset_refs \u5747\u80fd\u56de\u5230\u5177\u4f53\u8d44\u4ea7\u3002",
      "style": "Normal"
    },
    {
      "para_index": 145,
      "text": "\u5b9e\u73b0\u8f93\u5165\u793a\u4f8b",
      "style": "Normal"
    },
    {
      "para_index": 156,
      "text": "P00 \u00b7 BASE_SYSTEM_PROMPT",
      "style": "Normal"
    },
    {
      "para_index": 159,
      "text": "P01 \u00b7 \u81ea\u52a8\u63a8\u8350",
      "style": "Normal"
    },
    {
      "para_index": 161,
      "text": "P02 \u00b7 UGC \u771f\u5b9e\u6d4b\u8bc4",
      "style": "Normal"
    },
    {
      "para_index": 163,
      "text": "P03 \u00b7 \u75db\u70b9\u89e3\u51b3",
      "style": "Normal"
    }
