  "direct_run_formatting_runs": 826,
  "direct_paragraph_formatting_paragraphs": 155,
  "heading_like_paragraphs_not_heading_style": [
    {
      "para_index": 1,
      "text": "PRODUCT REQUIREMENTS DOCUMENT \u00b7 RESTRUCTURED",
      "style": "Normal"
    },
    {
      "para_index": 4,
      "text": "\u7248\u672c\uff1aV2.0\uff08\u57fa\u4e8e\u9886\u5bfc AI \u521d\u7a3f\u91cd\u6784\uff09",
      "style": "Normal"
    },
    {
      "para_index": 5,
      "text": "\u65e5\u671f\uff1a2026-08-31",
      "style": "Normal"
    },
    {
      "para_index": 6,
      "text": "\u76ee\u6807\u8bfb\u8005\uff1a\u4ea7\u54c1\u3001\u6570\u636e\u3001\u7b97\u6cd5\u3001\u524d\u7aef\u3001\u540e\u7aef\u3001\u6d4b\u8bd5\u3001TikTok Shop GMV Max \u6295\u653e AO",
      "style": "Normal"
    },
    {
      "para_index": 7,
      "text": "\u6587\u6863\u72b6\u6001\uff1a\u53ef\u7528\u4e8e\u6280\u672f\u65b9\u6848\u8bc4\u5ba1\uff1b\u5e73\u53f0\u63a5\u53e3\u3001\u5f52\u56e0\u53e3\u5f84\u4e0e\u9608\u503c\u4ecd\u9700\u4e1a\u52a1/\u6570\u636e Owner \u786e\u8ba4",
      "style": "Normal"
    },
    {
      "para_index": 8,
      "text": "\u4ea7\u54c1\u8303\u56f4\uff1a\u7ecf\u8425\u603b\u89c8 \u2192 \u7d20\u6750\u8bca\u65ad \u2192 \u521b\u610f\u751f\u6210/\u52a8\u4f5c\u914d\u7f6e \u2192 \u6295\u653e\u4e2d\u5fc3 \u2192 \u4efb\u52a1\u4e0e\u7ed3\u679c\u56de\u6d41",
      "style": "Normal"
    },
    {
      "para_index": 24,
      "text": "\u5de5\u7a0b\u7ea6\u675f  \u524d\u7aef\u4e0d\u5f97\u7ee7\u7eed\u76f4\u63a5\u8ba1\u7b97\u6b63\u5f0f\u8bca\u65ad\u7ed3\u8bba\u3002P0 \u5e94\u5148\u5b9a\u4e49\u670d\u52a1\u7aef/\u9886\u57df\u5c42\u7684\u6307\u6807\u4e0e\u89c4\u5219\u8f93\u51fa\uff0c\u524d\u7aef\u53ea\u6e32\u67d3\u7ed3\u679c\u3001\u8bc1\u636e\u4e0e\u5141\u8bb8\u52a8\u4f5c\uff1bDemo \u6570\u503c\u4e0d\u5f97\u6210\u4e3a\u751f\u4ea7\u9ed8\u8ba4\u503c\u3002",
      "style": "Normal"
    },
    {
      "para_index": 57,
      "text": "\u9009\u62e9\u4e0a\u4e0b\u6587\uff1aAO \u9009\u62e9\u5e73\u53f0\u3001\u5e97\u94fa\u3001\u8d26\u6237\u3001\u56fd\u5bb6\u4e0e\u65f6\u95f4\u8303\u56f4\uff1b\u7cfb\u7edf\u8fd4\u56de data_as_of \u4e0e\u65f6\u533a\u3002",
      "style": "Normal"
    },
    {
      "para_index": 58,
      "text": "\u7ecf\u8425\u805a\u5408\u4e0e\u6392\u961f\uff1a\u6309\u5546\u54c1\u805a\u5408 GMV/Spend/ROI\u3001\u7d20\u6750\u4f9b\u7ed9\u4e0e\u5f02\u5e38\u4fe1\u53f7\uff0c\u8f93\u51fa\u4eca\u65e5\u5904\u7406\u961f\u5217\u3002",
      "style": "Normal"
    },
    {
      "para_index": 59,
      "text": "\u6570\u636e\u8d44\u683c\u6821\u9a8c\uff1a\u68c0\u67e5\u6570\u636e\u5b8c\u6574\u6027\u3001\u5ef6\u8fdf\u3001\u5f52\u56e0\u7a97\u53e3\u3001\u6837\u672c\u95e8\u69db\u4e0e Benchmark \u7f6e\u4fe1\u5ea6\uff1b\u4e0d\u5408\u683c\u76f4\u63a5\u8fdb\u5165\u5f85\u89c2\u5bdf\u3002",
      "style": "Normal"
    },
    {
      "para_index": 60,
      "text": "\u5f52\u56e0\u4fdd\u62a4\uff1a\u5f53\u7d20\u6750\u6f0f\u6597\u6307\u6807\u6b63\u5e38\u800c ROI \u4e0d\u8fbe\u6807\uff0c\u68c0\u67e5 AOV\u3001Offer\u3001\u5e93\u5b58\u3001\u6bdb\u5229/\u76ee\u6807\u3001\u8d26\u6237\u6216\u5e73\u53f0\u72b6\u6001\uff1b\u547d\u4e2d\u540e\u7981\u6b62\u7d20\u6750\u52a8\u4f5c\u3002",
      "style": "Normal"
    },
    {
      "para_index": 61,
      "text": "\u751f\u6210\u8bca\u65ad\u5feb\u7167\uff1a\u51bb\u7ed3 Product \u00d7 Creative \u00d7 Context \u7684\u5b9e\u9645\u503c\u3001\u57fa\u51c6\u3001Index\u3001\u8d8b\u52bf\u3001\u89c4\u5219\u7248\u672c\u4e0e\u552f\u4e00\u4e3b\u7ed3\u679c\u3002",
      "style": "Normal"
    },
    {
      "para_index": 62,
      "text": "\u521b\u5efa\u552f\u4e00\u4e3b\u52a8\u4f5c\uff1a\u6839\u636e\u7ed3\u679c\u751f\u6210\u653e\u91cf\u3001\u4fdd\u6301\u3001\u89c2\u5bdf\u3001\u8fed\u4ee3\u3001\u6362\u65b0\u6216\u5173\u505c\u7684 Action Intent\uff1b\u6b21\u7ea7\u5165\u53e3\u4ec5\u7528\u4e8e\u67e5\u770b\u8bc1\u636e\u3002",
      "style": "Normal"
    },
    {
      "para_index": 63,
      "text": "\u6267\u884c\u5206\u652f\uff1a\u751f\u6210\u7c7b\u8fdb\u5165\u65b9\u5411/\u53d8\u91cf\u9009\u62e9\u4e0e\u7d20\u6750\u751f\u6210\uff1b\u76d1\u63a7\u7c7b\u521b\u5efa\u590d\u67e5\u4efb\u52a1\uff1b\u5173\u505c\u7c7b\u8fdb\u5165\u5f71\u54cd\u786e\u8ba4\u3002",
      "style": "Normal"
    },
    {
      "para_index": 64,
      "text": "\u4fdd\u5b58\u6295\u653e\u8349\u7a3f\uff1a\u751f\u6210\u6216\u590d\u7528\u7d20\u6750\u540e\u914d\u7f6e Target ROI\u3001\u65e5\u9884\u7b97\u3001\u89c2\u5bdf\u65f6\u957f\u3001\u80dc\u51fa\u8ba2\u5355\u7ebf\u4e0e\u6b62\u635f ROI\uff0c\u4fdd\u5b58\u8349\u7a3f\u3002",
      "style": "Normal"
    },
    {
      "para_index": 65,
      "text": "\u4eba\u5de5\u786e\u8ba4\u4e0e\u5e73\u53f0\u6267\u884c\uff1aAO \u786e\u8ba4\u540e\u8c03\u7528\u5e73\u53f0\uff1b\u521b\u5efa\u6210\u529f\u4e0e\u5b9e\u9645\u6295\u653e\u72b6\u6001\u5206\u79bb\uff0c\u5e76\u6301\u7eed\u540c\u6b65\u5ba1\u6838/\u6295\u653e\u72b6\u6001\u3002",
      "style": "Normal"
    },
    {
      "para_index": 66,
      "text": "\u89c2\u6d4b\u3001\u9a8c\u6536\u4e0e\u56de\u6d41\uff1a\u540c\u65f6\u6ee1\u8db3\u89c2\u5bdf\u65f6\u95f4\u548c\u8ba2\u5355\u6837\u672c\u540e\uff0c\u6bd4\u8f83\u539f\u7d20\u6750\u4e0e\u53d8\u4f53/\u65b0\u914d\u7f6e\uff1b\u7ed3\u679c\u56de\u5199 Benchmark\u3001\u4efb\u52a1\u548c\u4e0b\u4e00\u8f6e\u8bca\u65ad\u3002",
      "style": "Normal"
    },
    {
      "para_index": 74,
      "text": "\u70b9\u51fb\u7387  ctr = clicks / impressions\nimpressions \u4e3a 0 \u6216\u6570\u636e\u7f3a\u5931\u65f6\u8fd4\u56de null\uff1b\u4e0d\u5f97\u4ee5 0 \u53c2\u4e0e Index\u3002",
      "style": "Normal"
    },
    {
      "para_index": 75,
      "text": "\u8f6c\u5316\u7387  cvr = orders / clicks\nclicks \u4e3a 0 \u65f6\u8fd4\u56de null\uff1b\u8ba2\u5355\u53e3\u5f84\u5fc5\u987b\u4e0e GMV \u5f52\u56e0\u4e00\u81f4\u3002",
      "style": "Normal"
    },
    {
      "para_index": 76,
      "text": "\u5ba2\u5355\u4ef7  aov = gross_revenue / orders\norders \u4e3a 0 \u65f6\u8fd4\u56de null\uff1b\u7981\u6b62\u5c55\u793a\u4e3a $0 \u4ee5\u514d\u8bef\u5bfc\u3002",
      "style": "Normal"
    }
  ],
