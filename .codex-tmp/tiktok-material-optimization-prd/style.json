  "heading_like_paragraphs_not_heading_style": [
    {
      "para_index": 1,
      "text": "PRODUCT REQUIREMENTS DOCUMENT \u00b7 SOLUTION BLUEPRINT",
      "style": "Normal"
    },
    {
      "para_index": 4,
      "text": "\u7248\u672c\uff1aV1.0\uff08\u8bc4\u5ba1\u7a3f\uff09",
      "style": "Normal"
    },
    {
      "para_index": 5,
      "text": "\u65e5\u671f\uff1a2026-08-31",
      "style": "Normal"
    },
    {
      "para_index": 6,
      "text": "\u76ee\u6807\u8bfb\u8005\uff1a\u4ea7\u54c1\u3001\u6295\u653e AO\u3001\u521b\u610f\u7b56\u7565\u3001\u6570\u636e/\u7b97\u6cd5\u3001\u524d\u540e\u7aef\u3001\u751f\u6210\u5e73\u53f0\u3001\u5ba2\u6237\u6210\u529f",
      "style": "Normal"
    },
    {
      "para_index": 7,
      "text": "\u9996\u671f\u8303\u56f4\uff1aProduct GMV Max \u4f18\u5148\uff1b\u517c\u5bb9\u6807\u51c6 TikTok Shop Ads \u7684\u7d20\u6750\u8bca\u65ad\u964d\u7ea7\u8def\u5f84",
      "style": "Normal"
    },
    {
      "para_index": 8,
      "text": "\u6587\u6863\u72b6\u6001\uff1a\u53ef\u8fdb\u5165\u4ea7\u54c1/\u6570\u636e\u8054\u5408\u8bc4\u5ba1\uff1b\u5b57\u6bb5\u6743\u9650\u3001\u9608\u503c\u4e0e\u5f52\u56e0\u53e3\u5f84\u9700\u5728\u76ee\u6807\u5ba2\u6237\u8d26\u53f7\u505a\u6837\u672c\u63a2\u6d4b",
      "style": "Normal"
    },
    {
      "para_index": 14,
      "text": "\u672c\u7ae0\u8981\u56de\u7b54  \u4e3a\u4ec0\u4e48\u8981\u505a\u3001\u505a\u6210\u4ec0\u4e48\u3001\u9996\u671f\u54ea\u4e9b\u5224\u65ad\u5fc5\u987b\u514b\u5236\u3002",
      "style": "Normal"
    },
    {
      "para_index": 34,
      "text": "\u672c\u7ae0\u8981\u56de\u7b54  \u4f5c\u4e3a\u4e00\u7ea7\u5e7f\u544a\u4ee3\u7406\uff0c\u54ea\u4e9b\u6570\u636e\u53ef\u80fd\u83b7\u5f97\u3001\u5982\u4f55\u83b7\u5f97\u3001\u54ea\u4e9b\u4e0d\u80fd\u9ed8\u8ba4\u83b7\u5f97\u3002",
      "style": "Normal"
    },
    {
      "para_index": 52,
      "text": "\u672c\u7ae0\u8981\u56de\u7b54  \u8c01\u5728\u4ec0\u4e48\u65f6\u523b\u4f7f\u7528\u4ea7\u54c1\uff0c\u4ee5\u53ca\u8bca\u65ad\u5982\u4f55\u81ea\u7136\u5bfc\u5411\u589e\u5f3a\u590d\u523b\u6216\u89c6\u9891\u751f\u6210\u3002",
      "style": "Normal"
    },
    {
      "para_index": 67,
      "text": "\u672c\u7ae0\u8981\u56de\u7b54  \u600e\u6837\u628a\u6295\u653e\u6307\u6807\u7ffb\u8bd1\u6210\u521b\u610f\u7ed3\u6784\uff0c\u53c8\u907f\u514d\u628a\u76f8\u5173\u6027\u5305\u88c5\u6210\u56e0\u679c\u3002",
      "style": "Normal"
    },
    {
      "para_index": 84,
      "text": "\u672c\u7ae0\u8981\u56de\u7b54  \u4ece\u6570\u636e\u8d44\u683c\u3001\u7a33\u5065\u57fa\u51c6\u3001\u5206\u6bb5\u5065\u5eb7\u5230\u4e3b\u8bca\u65ad\u3001\u7f6e\u4fe1\u5ea6\u548c\u52a8\u4f5c\u4f18\u5148\u7ea7\u7684\u5b8c\u6574\u8ba1\u7b97\u3002",
      "style": "Normal"
    },
    {
      "para_index": 110,
      "text": "\u547d\u540d\u4fdd\u62a4  \u53ea\u8981\u6ca1\u6709\u7a33\u5b9a\u5386\u53f2\u4e0e\u6301\u7eed\u8870\u51cf\u8bc1\u636e\uff0c\u9875\u9762\u4f7f\u7528\u201c\u8868\u73b0\u5f31/\u6f0f\u6597\u7f3a\u53e3\u201d\uff0c\u4e0d\u4f7f\u7528\u201c\u7d20\u6750\u75b2\u52b3\u201d\u3002",
      "style": "Normal"
    },
    {
      "para_index": 122,
      "text": "\u672c\u7ae0\u8981\u56de\u7b54  \u4ece\u6570\u636e\u63a5\u5165\u5230\u7ed3\u679c\u56de\u6d41\uff0c\u54ea\u4e9b\u6a21\u5757\u5c5e\u4e8e P0/P1/P2\u3002",
      "style": "Normal"
    },
    {
      "para_index": 125,
      "text": "\u672c\u7ae0\u8981\u56de\u7b54  \u6bcf\u4e2a\u6838\u5fc3\u6a21\u5757\u7684\u76ee\u7684\u3001\u8f93\u5165\u3001\u8ba1\u7b97\u3001\u8f93\u51fa\u3001\u5f02\u5e38\u72b6\u6001\u548c\u9a8c\u6536\u3002",
      "style": "Normal"
    },
    {
      "para_index": 127,
      "text": "\u4e1a\u52a1\u76ee\u7684\uff1a\u5728\u4efb\u4f55\u8bca\u65ad\u524d\u56de\u7b54\u201c\u6211\u4eec\u88ab\u6388\u6743\u770b\u4ec0\u4e48\u3001\u6570\u636e\u5230\u54ea\u4e00\u5929\u3001\u54ea\u4e9b\u6307\u6807\u80fd\u7528\u201d\u3002",
      "style": "Normal"
    },
    {
      "para_index": 128,
      "text": "\u7528\u6237\u5165\u53e3\uff1a\u8bbe\u7f6e > \u6570\u636e\u8fde\u63a5\uff1b\u9996\u6b21\u8fdb\u5165\u7d20\u6750\u8bca\u65ad\u65f6\u81ea\u52a8\u68c0\u67e5\u3002",
      "style": "Normal"
    },
    {
      "para_index": 155,
      "text": "\u4e1a\u52a1\u76ee\u7684\uff1a\u8ba9\u6295\u624b\u5148\u5904\u7406\u5f71\u54cd\u6700\u5927\u4e14\u6700\u53ef\u6267\u884c\u7684\u7d20\u6750\uff0c\u800c\u4e0d\u662f\u6d4f\u89c8\u5168\u91cf\u62a5\u8868\u3002",
      "style": "Normal"
    },
    {
      "para_index": 156,
      "text": "\u7528\u6237\u5165\u53e3\uff1a\u6d1e\u5bdf > \u7d20\u6750\u8bca\u65ad\uff1b\u4e5f\u53ef\u4ece\u81ea\u52a8\u62a5\u8868\u6216 Agent \u7ed3\u679c\u8fdb\u5165\u3002",
      "style": "Normal"
    },
    {
      "para_index": 180,
      "text": "\u4e1a\u52a1\u76ee\u7684\uff1a\u7528\u53ef\u89e3\u91ca\u8bc1\u636e\u56de\u7b54\u201c\u4e3a\u4ec0\u4e48\u8fd9\u4e48\u5224\u65ad\u3001\u4e0b\u4e00\u6b65\u5177\u4f53\u6539\u4ec0\u4e48\u201d\u3002",
      "style": "Normal"
    },
    {
      "para_index": 181,
      "text": "\u7528\u6237\u5165\u53e3\uff1a\u673a\u4f1a\u961f\u5217\u7d20\u6750\u884c\uff1b\u6295\u653e\u62a5\u8868\u7d20\u6750\u8be6\u60c5\uff1bAgent \u5efa\u8bae\u5361\u7247\u3002",
      "style": "Normal"
    }
  ],
